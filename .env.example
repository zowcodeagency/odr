# Supabase — transaction pooler (used by the API at runtime)
DATABASE_URL=postgresql://postgres.vgtrqvsicskebnqyzwfd:REPLACE_ME@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres
# Supabase — direct connection (used by drizzle-kit for migrations only; pooler can't run DDL safely)
DIRECT_URL=postgresql://postgres:REPLACE_ME@db.vgtrqvsicskebnqyzwfd.supabase.co:5432/postgres

REDIS_URL=redis://localhost:6379
API_PORT=3000
JWT_SECRET=dev-only-change-me
NODE_ENV=development
DEFAULT_COUNTRY=IN

# Internal admin API bearer key (/admin/*). Generate with: openssl rand -hex 32
ADMIN_KEY=replace-me-openssl-rand-hex-32

# Supabase Auth — backs the admin-console team sign-in (anon key is publishable)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=replace-me-anon-key
